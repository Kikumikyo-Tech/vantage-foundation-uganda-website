# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# Raw programme photos awaiting curation (see docs/media-guidelines.md Phase 6).
# Do not commit 40 MB of UUID-named originals; curated images go in public/images/.
vantage photos/
vantage images/
vantage_photos/

# Intermediate image processing reports (not needed in repo)
scripts/exif-report.json
scripts/exif-detailed.json
scripts/image-manifest-template.json

# Local install artifacts (Windows space-in-path workaround)
npm-install*.log
.commit-msg.txt
.pr-body.md

# Large binary reference documents (kept locally, not in repo)
# These PDFs are ~15 MB total and bloat the git history.
# Coordinate a history rewrite (git filter-repo) with management to fully remove.
reference/*.pdf
